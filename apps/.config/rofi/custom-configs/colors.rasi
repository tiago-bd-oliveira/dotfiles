/* ROFI COLOR SCHEME - CATPPUCCIN MOCHA
 * Shared color definitions for all rofi configs
 */

* {
    /* --- FONTS --- */
    font:   "JetBrains Mono Nerd Font Mono 14";

    /* --- COLOR PALETTE --- */
    main-fg:         #cdd6f4;
    main-bg:         #11111bDD;
    main-br:         #cdd6f4;
    
    active-bg:       #9399b2DD;
    active-fg:       #11111b;
    
    secondary-bg:    #1e1e2eEE; 
    urgent-color:    #f38ba8;

    /* --- GLOBAL VARS --- */
    background-color:   transparent;
    text-color:         @main-fg;
    margin:     0;
    padding:    0;
    spacing:    0;
}
