/* ROFI BASE THEME - SQUARED CATPPUCCIN MOCHA
 * Core layout and styling - import colors first
 */

@import "colors.rasi"
@import "~/.cache/wal/colors-rofi.rasi"

window {
    location:   center;
    width:      480;

    background-color:   @main-bg;
    
    border-color:       @active-bg;
    border-radius:      2px;
}

inputbar {
    spacing:    8px;
    padding:    8px;

    border-color:       @active-bg;
    background-color:   @secondary-bg;
    children:           [ prompt, entry ];
}

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt {
    text-color: @active-bg;
    font:       "JetBrains Mono Nerd Font Bold 12";
    margin:     0px 10px 0px 0px;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @active-bg;
}

textbox {
    padding:            8px;
    background-color:   @secondary-bg;
}

listview {
    padding:    4px 0;
    columns:    1;
    scrollbar:  false;
}

element {
    padding:    8px;
    spacing:    8px;
}

/* --- ELEMENT STATES --- */

element normal.normal {
    text-color: @main-fg;
}

element normal.urgent {
    text-color: @urgent-color;
}

element normal.active {
    text-color: @active-bg;
}

/* Selected Item (Hover) */
element selected.normal, element selected.active {
    background-color:   @active-bg;
    text-color:         @active-fg;
    border-radius:      0px;
}

element selected.urgent {
    background-color:   @urgent-color;
    text-color:         @main-bg;
}

element-icon {
    size:   1.0em;
}

element-text {
    text-color: inherit;
}
