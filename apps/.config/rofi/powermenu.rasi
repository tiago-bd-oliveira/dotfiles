/*
 * ROFI POWER MENU - SQUARED CATPPUCCIN MOCHA 
 * Based on your provided Squared Nord configuration
 */

@theme "/home/tiago/.local/share/rofi/themes/squared-nord.rasi"


configuration {
    /* We only need dmenu mode for this */
    modi: "dmenu";
    show-icons: false;
}

/* --- THEME DEFINITION --- */
* {
    /* --- FONTS --- */
    font:   "JetBrains Mono Nerd Font Mono 14";

    /* --- COLOR PALETTE --- */
    main-fg:         #cdd6f4;
    main-bg:         #11111bDD;
    main-br:         #cdd6f4;
    
    active-bg:       #9399b2DD;
    active-fg:       #11111b;
    
    secondary-bg:    #1e1e2eEE; 
    urgent-color:    #f38ba8;

    /* --- GLOBAL VARS --- */
    background-color:   transparent;
    text-color:         @main-fg;
    margin:     0;
    padding:    0;
    spacing:    0;
}


inputbar {
    enabled: true;
    padding: 10px 10px 10px 16px; /* Padding around the title */
    /* Only show the prompt, hide the text entry */
    children: [ prompt ];
}

prompt {
    text-color: @main-fg;
    font: "JetBrains Mono Nerd Font Bold 12"; /* Slightly bigger/bold for title */
    width: 100%;
    horizontal-align: 0.5; /* Center the title text */
    vertical-align: 0.5;
}



listview {
    lines:              6; /* Exact fit for: Lock, Shutdown, Reboot, Suspend, Hibernate, Logout */
}

element {
    padding: 8px 8px 8px 16px;
}
