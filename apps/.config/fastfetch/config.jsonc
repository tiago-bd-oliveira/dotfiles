{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "de",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}"
    },
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    {
  	"type": "media",
  	"format": "{artist} - {title}"
    }
  ],
  "logo": {
    "type": "kitty",
    "source": "/home/tiago/Pictures/pokemon_sprites/*.webp",
    "width": 30, // <--- THIS IS CRITICAL. Forces the image to be 30 chars wide.
    "height": 12, // Height ensures aspect ratio
    "padding": {
      "top": 2,
      "left": 2
    },
    "preserveAspectRatio": true,
    "recache": true
  }
}
