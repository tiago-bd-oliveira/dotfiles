# ~/.dotfiles/.gitignore

# System junk
.DS_Store
*.zwc
*.pyc

# Secrets (Double check these!)
.ssh/
.gnupg/
.git-credentials
.env*
*.p12
*.pem

# VS Code junk
.vscode/extensions/
.vscode/argv.json

# VS Code runtime data (~/.config/Code is symlinked into the repo) — keep only user config
vscode/.config/Code/*
!vscode/.config/Code/User/
vscode/.config/Code/User/*
!vscode/.config/Code/User/settings.json
!vscode/.config/Code/User/keybindings.json
!vscode/.config/Code/User/snippets/

# OneDrive runtime data — keep only config and sync_list (refresh_token is a secret)
apps/.config/onedrive/*
!apps/.config/onedrive/config
!apps/.config/onedrive/sync_list
